; Engine configuration file.
; Project Snow Crash: starter skeleton (Godot 4.7.x)

config_version=5

[application]

config/name="Snow Crash"
config/description="A walkable VR file explorer. Read-only by default."
config/version="0.3.0-demo"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/use_custom_user_dir=true
config/custom_user_dir_name="SnowCrash"

[autoload]

Settings="*res://autoload/settings.gd"
AppState="*res://autoload/app_state.gd"
FileIndex="*res://autoload/file_index.gd"
ThumbnailCache="*res://autoload/thumbnail_cache.gd"
Notifications="*res://autoload/notifications.gd"
Launcher="*res://autoload/launcher.gd"
SearchService="*res://autoload/search_service.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/enabled.flat_build=false
openxr/startup_alert=false
shaders/enabled=true
